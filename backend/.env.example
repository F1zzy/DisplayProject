# Copy to .env and fill in your API keys.
# Server-side keys are not exposed to the browser.

PORT=3000
HOST=0.0.0.0
LOCATION=Nottingham
CONTROL_API_KEY=change-me-to-a-random-secret

WEATHER_API_KEY=your_weatherapi_key
NEWS_API_KEY=your_newsapi_key
STOCK_API_KEY=your_alphavantage_key

# Google Calendar (optional — Schedule widget)
# Create a Desktop OAuth client, enable Calendar API, then run:
#   node scripts/google-calendar-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Raspberry Pi HDMI control (optional; set by install.sh)
# DISPLAY_POWER_CMD=/usr/local/bin/displayproject-display-power
