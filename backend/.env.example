# Copy to .env and fill in your API keys.
# Server-side keys are not exposed to the browser.

PORT=3000
HOST=0.0.0.0
LOCATION=Nottingham
CONTROL_API_KEY=change-me-to-a-random-secret

WEATHER_API_KEY=your_weatherapi_key
NEWS_API_KEY=your_newsapi_key
STOCK_API_KEY=your_alphavantage_key

# Google Calendar (optional — Schedule widget)
# Create a Desktop OAuth client, enable Calendar API, then run:
#   node scripts/google-calendar-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Network widget — Go microservice (see network/README.md)
# Set to false to disable (API returns offline/degraded payload).
NETWORK_SERVICE_URL=http://127.0.0.1:3011
# Optional overrides on the Go network process (see network/README.md):
# NETWORK_IFACE=eth0
# NETWORK_PROBE_URL=https://www.gstatic.com/generate_204
# NETWORK_PUBLIC_IP_URL=https://api.ipify.org?format=json
# NETWORK_DNS_TARGET=1.1.1.1:443

# Night Sky widget (AstronomyAPI — star chart + planet/Moon positions)
# https://astronomyapi.com/
ASTRONOMY_APP_ID=
ASTRONOMY_APP_SECRET=
# Optional override if WeatherAPI geocoding is unavailable:
# SKY_LAT=52.95
# SKY_LON=-1.15

# Spotify widget (optional — Now Playing / recently played / top tracks)
# Create an app at https://developer.spotify.com/dashboard
# Add redirect URI http://127.0.0.1:3006/callback then run:
#   node scripts/spotify-auth.js
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Formula 1 widget
# Championship standings come from Jolpica and need no configuration.
# Live timing is an unofficial F1 feed; set to false to disable it entirely.
F1_LIVE_ENABLED=true
# Optional F1 account JWT (a free F1 account is enough). Without it the live
# feed may return partial or no data during a session; championship standings
# are unaffected either way. Tokens last ~4 days, so prefer the managed file at
# data/f1-token.json, which is renewed without a restart:
#   node scripts/f1-auth.js --login     once, in a visible browser
#   node scripts/f1-auth.js --refresh   thereafter, unattended
# This value is only the fallback when no token file exists.
F1_LIVE_TOKEN=
# Browser used by --login / --refresh. Leave unset to use Playwright's own
# Chromium; on a Raspberry Pi point it at the system one.
# F1_BROWSER_PATH=/usr/bin/chromium

# Analytics microservice (optional Go service — see analytics/README.md)
# Set to false to disable ingest/summary proxying.
ANALYTICS_URL=http://127.0.0.1:3010

# Raspberry Pi HDMI control (optional; set by install.sh)
# DISPLAY_POWER_CMD=/usr/local/bin/displayproject-display-power
# DISPLAY_BRIGHTNESS_CMD=/usr/local/bin/displayproject-display-brightness
