# Copy to .env and fill in your API keys.
# Server-side keys are not exposed to the browser.

PORT=3000
HOST=0.0.0.0
LOCATION=Nottingham
CONTROL_API_KEY=change-me-to-a-random-secret

WEATHER_API_KEY=your_weatherapi_key
NEWS_API_KEY=your_newsapi_key
STOCK_API_KEY=your_alphavantage_key

# Google Calendar (optional — Schedule widget)
# Create a Desktop OAuth client, enable Calendar API, then run:
#   node scripts/google-calendar-auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Network widget (optional)
# NETWORK_IFACE=eth0
# NETWORK_PROBE_URL=https://www.gstatic.com/generate_204

# Night Sky widget (AstronomyAPI — star chart + planet/Moon positions)
# https://astronomyapi.com/
ASTRONOMY_APP_ID=
ASTRONOMY_APP_SECRET=
# Optional override if WeatherAPI geocoding is unavailable:
# SKY_LAT=52.95
# SKY_LON=-1.15

# Spotify widget (optional — Now Playing / recently played / top tracks)
# Create an app at https://developer.spotify.com/dashboard
# Add redirect URI http://localhost:3006/callback then run:
#   node scripts/spotify-auth.js
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Raspberry Pi HDMI control (optional; set by install.sh)
# DISPLAY_POWER_CMD=/usr/local/bin/displayproject-display-power
# DISPLAY_BRIGHTNESS_CMD=/usr/local/bin/displayproject-display-brightness
